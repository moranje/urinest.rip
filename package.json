{
  "name": "urinest-rip",
  "version": "3.4.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:flows": "node scripts/build-flows.mjs",
    "build": "vite build",
    "pretest": "npm run build:flows",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "vue-tsc --noEmit",
    "check:tsgo": "tsgo --noEmit --project tsconfig.tsgo.json",
    "check:tsgo:app": "tsgo --noEmit --project tsconfig.app.tsgo.json",
    "tokens:write": "node scripts/check-design-tokens.mjs --write",
    "tokens:distribution:write": "node scripts/check-design-token-distribution.mjs --write",
    "check:design-tokens": "node scripts/check-design-tokens.mjs",
    "check:design-token-distribution": "node scripts/check-design-token-distribution.mjs",
    "check:modern-toolchain": "node scripts/check-modern-toolchain.mjs",
    "check:app": "npm run build:flows && npm run check:design-tokens && npm run check:design-token-distribution && npm run check:modern-toolchain && npm run format:check && npm run lint:all && npm run check && npm run check:tsgo:app && npm run test:app && npm run test:consumer:urinestrip:only && npm run check:guidelines && npm run build && npm run budget:app",
    "check:framework": "npm run check:consumer-imports && npm run check:consumer:urinestrip:only && npm run test:consumer:urinestrip:only",
    "check:browser-smoke": "node scripts/check-browser-regression-smoke.mjs",
    "check:consumer-imports": "node scripts/check-consumer-package-imports.mjs",
    "check:consumer:urinestrip": "npm run check:consumer:urinestrip:only && npm run test:consumer:urinestrip:only",
    "check:consumer:urinestrip:only": "tsc -p fixtures/urinestrip-consumer/tsconfig.json --noEmit",
    "check:guideline-traceability": "node scripts/check-guideline-traceability.mjs",
    "check:role-responsibility": "node scripts/check-role-responsibility-matrix.mjs",
    "check:clinical-copy:only": "node scripts/check-clinical-dutch-copy.mjs",
    "check:clinical-copy": "npm run build:flows && npm run check:clinical-copy:only",
    "check:guidelines": "npm run build:flows && npm run check:guideline-traceability && npm run check:role-responsibility && npm run check:clinical-copy:only",
    "format": "oxfmt --write src/ fixtures/",
    "format:check": "oxfmt --check src/ fixtures/",
    "budget": "npm run budget:app",
    "budget:app": "node scripts/check-bundle-budget.mjs",
    "check:lighthouse:only": "node scripts/check-lighthouse.mjs",
    "check:lighthouse": "npm run build && npm run check:lighthouse:only",
    "lint": "oxlint src/ fixtures/ --deny-warnings",
    "lint:eslint": "eslint src/ fixtures/",
    "lint:all": "oxlint src/ fixtures/ --deny-warnings && eslint src/ fixtures/",
    "test": "npm run test:app && npm run test:consumer:urinestrip:only",
    "test:app": "vitest run --config vitest.config.app.ts",
    "test:consumer:urinestrip": "npm run test:consumer:urinestrip:only",
    "test:consumer:urinestrip:only": "vitest run --config fixtures/urinestrip-consumer/vitest.config.ts",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@moranje/beslismodel": "0.1.1",
    "@supabase/supabase-js": "^2.97.0",
    "dompurify": "^3.4.7",
    "marked": "^17.0.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@emnapi/core": "^1.10.0",
    "@emnapi/runtime": "^1.10.0",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@types/dompurify": "^3.0.5",
    "@typescript/native-preview": "^7.0.0-dev.20260601.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "ajv": "^8.18.0",
    "ajv-formats": "3.0.1",
    "axe-core": "^4.11.4",
    "chrome-launcher": "^1.2.1",
    "eslint": "^10.0.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lighthouse": "^13.3.0",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "puppeteer-core": "^24.43.1",
    "storybook": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.3.3"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "oxlint --deny-warnings",
      "eslint"
    ],
    "*.{ts,vue,json,css}": "oxfmt --check"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
