{
  "name": "urinest-rip",
  "version": "3.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:flows": "node scripts/build-flows.mjs",
    "build": "vite build",
    "pretest": "npm run build:flows",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "vue-tsc --noEmit",
    "check:tsgo": "tsgo --noEmit --project tsconfig.tsgo.json",
    "check:guidelines": "node scripts/check-guideline-traceability.mjs",
    "format": "oxfmt --write src/ packages/",
    "format:check": "oxfmt --check src/ packages/",
    "budget": "node scripts/check-bundle-budget.mjs",
    "lint": "oxlint src/ packages/ --deny-warnings",
    "lint:eslint": "eslint src/ packages/",
    "lint:all": "oxlint src/ packages/ --deny-warnings && eslint src/ packages/",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "decision-engine-core": "file:decision-engine-core-1.0.0.tgz",
    "dompurify": "^3.4.7",
    "marked": "^17.0.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@types/dompurify": "^3.0.5",
    "@typescript/native-preview": "^7.0.0-dev.20260601.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.11.4",
    "eslint": "^10.0.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "storybook": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.3.3"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "oxlint --deny-warnings",
      "eslint"
    ],
    "*.{ts,vue,json,css}": "oxfmt --check"
  }
}
