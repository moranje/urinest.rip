{
  "name": "urinest-rip",
  "version": "3.3.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:flows": "node scripts/build-flows.mjs",
    "build:core": "vite build --config packages/core/vite.config.ts && tsc -p packages/core/tsconfig.json",
    "build:compiler": "vite build --config packages/compiler/vite.config.ts && tsc -p packages/compiler/tsconfig.json",
    "build:testing": "vite build --config packages/testing/vite.config.ts && tsc -p packages/testing/tsconfig.json",
    "build:vue:only": "vite build --config packages/vue/vite.config.ts && tsc -p packages/vue/tsconfig.json",
    "build:vue": "npm run build:core && npm run build:vue:only",
    "build:packages": "npm run build:core && npm run build:compiler && npm run build:vue:only && npm run build:testing",
    "build": "vite build",
    "pretest": "npm run build:flows",
    "preview": "vite preview",
    "prepare": "husky",
    "check": "vue-tsc --noEmit",
    "check:tsgo": "tsgo --noEmit --project tsconfig.tsgo.json",
    "check:core-package": "node scripts/check-core-package.mjs",
    "check:compiler-package": "node scripts/check-compiler-package.mjs",
    "check:testing-package": "node scripts/check-testing-package.mjs",
    "check:vue-package": "node scripts/check-vue-package.mjs",
    "check:package-release-config": "node scripts/check-package-release-config.mjs",
    "check:consumer-imports": "node scripts/check-consumer-package-imports.mjs",
    "check:framework-boundaries": "node scripts/check-framework-security-boundaries.mjs",
    "check:consumer:urinestrip": "npm run build:packages && npm run check:consumer:urinestrip:only",
    "check:consumer:urinestrip:only": "tsc -p fixtures/urinestrip-consumer/tsconfig.json --noEmit",
    "check:packages": "npm run check:consumer-imports && npm run check:framework-boundaries && npm run check:package-release-config && npm run build:packages && npm run check:core-package && npm run check:compiler-package && npm run check:vue-package && npm run check:testing-package && npm run check:consumer:urinestrip:only && npm run test:consumer:urinestrip:only",
    "check:guidelines": "node scripts/check-guideline-traceability.mjs",
    "format": "oxfmt --write src/ packages/ fixtures/",
    "format:check": "oxfmt --check src/ packages/ fixtures/",
    "budget": "npm run budget:app && npm run budget:packages",
    "budget:app": "node scripts/check-bundle-budget.mjs",
    "budget:packages": "node scripts/check-package-bundle-budget.mjs",
    "lint": "oxlint src/ packages/ fixtures/ --deny-warnings",
    "lint:eslint": "eslint src/ packages/ fixtures/",
    "lint:all": "oxlint src/ packages/ fixtures/ --deny-warnings && eslint src/ packages/ fixtures/",
    "test": "vitest run",
    "test:consumer:urinestrip": "npm run build:packages && npm run test:consumer:urinestrip:only",
    "test:consumer:urinestrip:only": "vitest run --config fixtures/urinestrip-consumer/vitest.config.ts",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.97.0",
    "dompurify": "^3.4.7",
    "marked": "^17.0.3",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.2",
    "@commitlint/config-conventional": "^20.4.2",
    "@storybook/addon-a11y": "^10.4.1",
    "@storybook/vue3-vite": "^10.4.1",
    "@types/dompurify": "^3.0.5",
    "@typescript/native-preview": "^7.0.0-dev.20260601.1",
    "@vite-pwa/assets-generator": "^1.0.2",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.6",
    "axe-core": "^4.11.4",
    "eslint": "^10.0.1",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.53.0",
    "oxlint": "^1.68.0",
    "storybook": "^10.4.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^8.0.16",
    "vite-plugin-compression": "^0.5.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.0.18",
    "vitest-axe": "^0.1.0",
    "vue-tsc": "^3.3.3"
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "oxlint --deny-warnings",
      "eslint"
    ],
    "*.{ts,vue,json,css}": "oxfmt --check"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
